{
  "name": "@yunzai-ng/webui-plugin",
  "version": "0.1.0",
  "description": "Yunzai NG 面板插件：schema 驱动的配置表单、账号登录、日志与插件管理",
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "author": "Yunzai-NG",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "yunzai": {
    "name": "webui"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yunzai-NG/webui-plugin.git"
  },
  "homepage": "https://github.com/Yunzai-NG/webui-plugin",
  "bugs": {
    "url": "https://github.com/Yunzai-NG/webui-plugin/issues"
  },
  "engines": {
    "node": ">=20.11.0"
  },
  "packageManager": "pnpm@9.15.4",
  "files": ["dist", "src", "web"],
  "scripts": {
    "build": "tsc -b && pnpm run build:web",
    "build:web": "vite build web",
    "build:clean": "tsc -b --clean",
    "dev:web": "vite web",
    "link:framework": "node scripts/link-framework.mjs",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "typecheck:web": "vue-tsc --noEmit -p web/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "verify": "pnpm run build && pnpm run typecheck:test && pnpm run typecheck:web && pnpm run lint && pnpm run test"
  },
  "peerDependencies": {
    "@yunzai-ng/core": ">=0.2.0",
    "@yunzai-ng/types": ">=0.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/node": "^22.10.5",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "@vitejs/plugin-vue": "6.0.8",
    "eslint": "^9.18.0",
    "eslint-plugin-jsdoc": "^50.6.1",
    "typescript": "^5.7.3",
    "vite": "8.2.2",
    "vitest": "^2.1.8",
    "vue": "3.5.41",
    "vue-tsc": "3.3.11"
  }
}
